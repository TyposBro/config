# Don't ignore flake.lock — it pins nixpkgs for reproducibility
# result/ symlinks from nix builds
result
result-*

# Taskplane runtime artifacts (machine-specific, do not commit)
.taskplane/.pi/batch-state.json
.taskplane/.pi/batch-history.json
.taskplane/.pi/lane-state-*
.taskplane/.pi/merge-result-*
.taskplane/.pi/merge-request-*
.taskplane/.pi/worker-conversation-*
.taskplane/.pi/orch-logs/
.taskplane/.pi/orch-abort-signal
.taskplane/.pi/settings.json
.taskplane/.worktrees/
.taskplane/.taskplane-tasks/

# Pi project-local packages (if using pi install -l)
.taskplane/.pi/npm/

# Agent/harness skills live in ~/agent-memory, not this PC setup repo
pi/skills/
pi/backups/

# OMP provider credentials are machine-local secrets.
omp/agent/models.yml
omp/agent/*.db*
omp/agent/sessions/
omp/agent/blobs/
omp/agent/mcp.json
omp/agent/terminal-sessions/
omp/agent/cache/
omp/agent/last-changelog-version
omp/cache/
omp/logs/
omp/gpu_cache.json
omp/plugins/
omp/run/
omp/install-id
omp/remote-host/
omp/ssh-control/
omp/puppeteer/

# Local MCP server installs keep source and lockfiles here, not dependency trees.
mcp/*/node_modules/

# Nested MCP checkouts keep their own git metadata local.
mcp/*/.git/
mcp/*/.git.local/
