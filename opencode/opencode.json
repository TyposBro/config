{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "instructions": [
    "{env:HOME}/agent-memory/shared/cto-workflow.md"
  ],
  "skills": {
    "paths": [
      "{env:HOME}/agent-memory/skills/audhd",
      "{env:HOME}/agent-memory/skills/codebase-design",
      "{env:HOME}/agent-memory/skills/diagnosing-bugs",
      "{env:HOME}/agent-memory/skills/domain-modeling",
      "{env:HOME}/agent-memory/skills/grilling",
      "{env:HOME}/agent-memory/skills/handoff",
      "{env:HOME}/agent-memory/skills/prototype",
      "{env:HOME}/agent-memory/skills/tdd",
      "{env:HOME}/agent-memory/skills/wise-teacher",
      "{env:HOME}/agent-memory/skills/writing-great-skills"
    ]
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
      "permission": {
        "edit": "deny"
      }
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "implement": {
      "description": "Implement bounded behavioral changes using existing repository patterns.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "small": {
      "description": "Handle cheap, bounded, low-risk discovery and pattern-preserving changes.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "review": {
      "description": "Review risky changes independently for correctness, security, and regressions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "max",
      "textVerbosity": "low",
      "permission": {
        "edit": "deny",
        "task": "deny"
      }
    }
  }
}
