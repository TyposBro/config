{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "agents": {
    "providers": {
      "omp": {
        "enabled": true,
        "params": {
          "sessionDir": "~/.omp/agent/sessions",
          "smolModel": "openai-codex/gpt-5.6-luna:xhigh",
          "slowModel": "openai-codex/gpt-5.6-sol:high",
          "planModel": "openai-codex/gpt-5.6-sol:high"
        }
      },
      "codex-cto": {
        "extends": "codex",
        "label": "Codex CTO",
        "description": "Sol main thread with Terra and Luna workers from the shared CTO profile.",
        "command": ["codex-cto"],
        "models": [
          {
            "id": "gpt-5.6-sol",
            "label": "GPT-5.6 Sol",
            "description": "CTO control plane; workers are routed internally.",
            "isDefault": true,
            "thinkingOptions": [
              {"id": "medium", "label": "Medium", "isDefault": true},
              {"id": "high", "label": "High"},
              {"id": "xhigh", "label": "Extra high"}
            ]
          }
        ]
      },
      "opencode-cto": {
        "extends": "opencode",
        "label": "OpenCode CTO",
        "description": "Sol main thread with Terra and Luna subagents from the shared OpenCode config.",
        "command": ["opencode"],
        "models": [
          {
            "id": "openai/gpt-5.6-sol",
            "label": "GPT-5.6 Sol",
            "description": "CTO control plane; workers are routed internally.",
            "isDefault": true,
            "thinkingOptions": [
              {"id": "medium", "label": "Medium", "isDefault": true},
              {"id": "high", "label": "High"},
              {"id": "xhigh", "label": "Extra high"}
            ]
          }
        ]
      }
    }
  }
}
