/**
 * Catppuccin Mocha Rofi Theme
 * Configured for Kubuntu + Ghostty
 **/

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               " 󰀻  Apps ";
    display-run:                " 󰲋  Run ";
    display-window:             " 󰕰  Window ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "JetBrainsMono Nerd Font 12";
    terminal:                   "ghostty";
}

@theme "/dev/null"

* {
    bg-col:      #1e1e2e;
    bg-col-light:#252538;
    border-col:  #cba6f7;
    selected-col:#313244;
    blue:        #89b4fa;
    mauve:       #cba6f7;
    fg-col:      #cdd6f4;
    fg-col2:     #f38ba8;
    grey:        #6c7086;

    width: 650;
    font: "JetBrainsMono Nerd Font 12";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 400px;
    border: 2px;
    border-color: @border-col;
    border-radius: 14px;
    background-color: @bg-col;
    padding: 14px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 8px;
    padding: 2px;
}

prompt {
    background-color: @mauve;
    padding: 6px 12px;
    text-color: @bg-col;
    border-radius: 6px;
    margin: 10px 0px 0px 10px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 10px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
    border-radius: 6px;
    placeholder: "Search...";
    placeholder-color: @grey;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 10px;
    columns: 2;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 6px 10px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
}

element selected {
    background-color:  @selected-col;
    text-color: @fg-col2;
    border: 1px;
    border-color: @mauve;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 8px 12px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
    border-radius: 6px;
    margin: 8px 4px 0px 4px;
}

button selected {
    background-color: @mauve;
    text-color: @bg-col;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 10px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col-light;
}
