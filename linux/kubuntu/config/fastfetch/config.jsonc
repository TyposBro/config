{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰍹 System",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󱑎 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "󰨇 Desktop",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "󰋊 Storage",
      "keyColor": "cyan"
    },
    {
      "type": "colors",
      "key": " Colors",
      "symbol": "circle"
    }
  ]
}
